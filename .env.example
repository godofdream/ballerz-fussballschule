# =============================================================================
# Ballerz Fußballschule – Environment variables
# Copy to .env (local) or set as Cloudflare Pages secrets / vars
# =============================================================================

# --- Cloudflare (for OpenTofu + deploy.sh) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=          # Needs: Workers Scripts, D1, R2, Pages edit

# --- Site ---
PUBLIC_SITE_URL=https://ballerz-fussballschule.de
PUBLIC_SITE_NAME=Ballerz Fußballschule

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Brevo ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@ballerz-fussballschule.de
BREVO_SENDER_NAME=Ballerz Fußballschule
BREVO_LIST_ID=

# --- Turnstile ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional ---
ADMIN_EMAIL=info@ballerz-fussballschule.de
